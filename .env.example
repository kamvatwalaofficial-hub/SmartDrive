# Copy to .env (never commit .env). Used by docker-compose and as a reference for the API's
# environment variables. ASP.NET Core maps "__" to ":" in configuration keys.

# --- SQL Server (docker-compose) ---
MSSQL_SA_PASSWORD=Choose-A-Strong-Local-Password-1

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__SmartDrive=Server=localhost,1433;Database=SmartDrive;User Id=sa;Password=Choose-A-Strong-Local-Password-1;TrustServerCertificate=True
# Required outside Development: at least 32 random characters, e.g. `openssl rand -base64 48`
Jwt__SigningKey=
Cors__AllowedOrigins__0=http://localhost:5173

# Local demo accounts created by the seeder (Development only; change them).
Seed__AdminPassword=SmartDrive-Admin-2026
Seed__CustomerPassword=SmartDrive-Demo-2026

# --- Optional: natural-language preference parsing via an OpenAI-compatible endpoint ---
# Leave blank to use the built-in rule-based parser. The model only extracts preferences;
# vehicles, prices and availability always come from the database.
Ai__LanguageModel__BaseUrl=
Ai__LanguageModel__ApiKey=
Ai__LanguageModel__Model=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:5080
