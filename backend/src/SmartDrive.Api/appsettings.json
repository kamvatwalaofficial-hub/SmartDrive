{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SmartDrive": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "SmartDrive.Api",
    "Audience": "SmartDrive.Web",
    "SigningKey": "",
    "ExpiryMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Api": {
    "ExposeDocumentation": false
  },
  "Rental": {
    "VatRate": 0.15,
    "GraceMinutes": 59,
    "MinimumLeadMinutes": 60,
    "MaximumRentalDays": 60,
    "MaximumAdvanceBookingDays": 365,
    "WeeklyDiscountMinDays": 7,
    "WeeklyDiscountRate": 0.10,
    "LongTermDiscountMinDays": 21,
    "LongTermDiscountRate": 0.15,
    "OneWayFee": 850,
    "TurnaroundMinutes": 120,
    "PendingHoldMinutes": 30,
    "FreeCancellationHours": 48,
    "LateCancellationFeeDays": 1,
    "ReviewWindowDays": 90,
    "ReviewEditWindowDays": 30
  },
  "Media": {
    "MaxBytes": 5242880
  },
  "Ai": {
    "LanguageModel": {
      "BaseUrl": "",
      "ApiKey": "",
      "Model": "",
      "TimeoutSeconds": 15
    }
  },
  "Seed": {
    "Enabled": false
  }
}
