<Project Sdk="Microsoft.NET.Sdk">
  <!-- Application services (use cases), EF Core persistence, Identity and seed data.
       Services orchestrate the pure rules in SmartDrive.Domain against the database. -->
  <PropertyGroup>
    <RootNamespace>SmartDrive.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartDrive.Domain\SmartDrive.Domain.csproj" />
  </ItemGroup>
</Project>
